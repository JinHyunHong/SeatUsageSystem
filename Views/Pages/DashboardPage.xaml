<Page
  x:Class="SeatUsageSystem.Views.Pages.DashboardPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:SeatUsageSystem.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="DashboardPage"
  d:DataContext="{d:DesignInstance local:DashboardPage,
                                     IsDesignTimeCreatable=False}"
  d:DesignHeight="450"
  d:DesignWidth="800"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  mc:Ignorable="d">

    <Grid x:Name="grdRoot">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" x:Name="loadingGrid" Visibility="Collapsed" Grid.ColumnSpan="2">

        </Grid>
        <!-- Loading -->

        <Grid Grid.Column="0" x:Name="dashboardGrid" Visibility="Visible" Grid.ColumnSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <ui:Card Background="DarkSlateGray" Margin="0,0,0,50">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                        <ui:SymbolIcon Symbol="Comment12" FontSize="18" FontWeight="Bold" Margin="0,0,5,0"/>
                        <ui:TextBlock x:Name="tbkWelcome" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="15" FontWeight="Bold" Text="{Binding ViewModel.WelcomeText, Mode=OneWay}"/>
                    </StackPanel>
                </ui:Card>
            </Grid>

            <!-- SUMMARY DATAS -->

            <Grid Grid.Row="1" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="● 좌석 현황" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,15"></TextBlock>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Width ="235" x:Name ="cbxArea" SelectedValue="{Binding ViewModel.SelectedAreaId}" ItemsSource="{Binding ViewModel.Areas}" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,15,0"/>
                        <ui:Button Width="100" Command="{Binding ViewModel.SearchSeatStatusCommand}" Height="auto" Content="조회" Foreground="WhiteSmoke" FontWeight="SemiBold" FontSize="15" Background="DarkSlateGray"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
            <!-- SEARCH DETAIL / CBX & SEARCH BTN-->

            <Grid Grid.Row="2" Margin="0,0,0,50">
                <!-- SEARCH DETAIL -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,15,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="150"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <ui:Card>
                            <StackPanel>
                                <TextBlock Text="전체 좌석 수" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <ui:Card Margin="0,0,0,10">
                                    <ui:TextBlock Margin="0,0,0,0" HorizontalAlignment="Center">
                                        <Run Text="{Binding ViewModel.TotalSeatCount, Mode=OneWay}" FontSize="30" FontWeight="Bold" Foreground="CadetBlue"/>
                                    </ui:TextBlock>
                                </ui:Card>
                            </StackPanel>
                        </ui:Card>
                    </Grid>
                </Grid>


                <Grid Grid.Column="1" Margin="0,0,15,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <ui:Card>
                            <StackPanel>
                                <TextBlock Text="이용 가능 좌석 수" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <ui:Card Margin="0,0,0,10">
                                    <ui:TextBlock Margin="0,0,0,0" HorizontalAlignment="Center">
                                        <Run Text="{Binding ViewModel.AvailableSeatCount, Mode=OneWay}" FontSize="30" FontWeight="Bold" Foreground="CadetBlue"/>
                                    </ui:TextBlock>
                                </ui:Card>
                            </StackPanel>
                        </ui:Card>
                    </Grid>
                </Grid>

                <Grid Grid.Column="2" Margin="0,0,15,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <ui:Card>
                            <StackPanel>
                                <TextBlock Text="이용 중 좌석 수" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <ui:Card Margin="0,0,0,10">
                                    <ui:TextBlock Margin="0,0,0,0" HorizontalAlignment="Center">
                                        <Run Text="{Binding ViewModel.InUseSeatCount, Mode=OneWay}" FontSize="30" FontWeight="Bold" Foreground="CadetBlue"/>
                                    </ui:TextBlock>
                                </ui:Card>
                            </StackPanel>
                        </ui:Card>
                    </Grid>
                </Grid>

                <Grid Grid.Column="3" Margin="0,0,15,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <ui:Card>
                            <StackPanel>
                                <TextBlock Text="오늘 이용 건수" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <ui:Card Margin="0,0,0,10">
                                    <ui:TextBlock Margin="0,0,0,0" HorizontalAlignment="Center">
                                        <Run Text="{Binding ViewModel.TodayUsageCount, Mode=OneWay}" FontSize="30" FontWeight="Bold" Foreground="CadetBlue"/>
                                    </ui:TextBlock>
                                </ui:Card>
                            </StackPanel>
                        </ui:Card>
                    </Grid>
                </Grid>
            </Grid>

            <!-- INFO -->

            <Grid Grid.Row="3" Margin="0,0,0,0">
                <StackPanel>
                    <TextBlock Text="● 바로가기" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,15"></TextBlock>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="4" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <ui:Card Grid.Column="0" VerticalAlignment="Top" Margin="0,0,15,0">
                    <ui:Button Height="180" Command="{Binding ViewModel.GoUsageCommand, Mode=OneWay}" HorizontalAlignment="Stretch" Foreground="White" FontWeight="Heavy" FontSize="30" Background="DarkSlateGray">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="DoorArrowLeft16" FontSize="60" Foreground="White" Margin="0,0,0,20"/>
                            <TextBlock Text="좌석 이용" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>
                </ui:Card>

                <ui:Card Grid.Column="1" VerticalAlignment="Top" Margin="0,0,15,0">
                    <ui:Button Height="180" Command="{Binding ViewModel.EndUsageCommand, Mode=OneWay}" HorizontalAlignment="Stretch" Foreground="IndianRed" FontWeight="Heavy" FontSize="30">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="DoorArrowRight16" FontSize="60" Foreground="White" Margin="0,0,0,20"/>
                            <TextBlock Text="이용 종료" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>
                </ui:Card>

                <ui:Card Grid.Column="2" VerticalAlignment="Top" Margin="0,0,15,0">
                    <ui:Button Height="180" Command="{Binding ViewModel.OpenDoorCommand, Mode=OneWay}" HorizontalAlignment="Stretch" Foreground="IndianRed" FontWeight="Heavy" FontSize="30">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="LockOpen16" FontSize="60" Foreground="White" Margin="0,0,0,20"/>
                            <TextBlock Text="문열기" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>
                </ui:Card>

                <ui:Card Grid.Column="3" VerticalAlignment="Top" Margin="0,0,15,0">
                    <ui:Button x:Name="btnAdminInfo" Click="btnAdminInfo_Click" Height="180" HorizontalAlignment="Stretch" Foreground="IndianRed" FontWeight="Heavy" FontSize="30">
                        <ui:Button.ContextMenu>
                            <ContextMenu Background="#1E1E1E"
                                         BorderThickness="0"
                                         HasDropShadow="True"
                                         IsHitTestVisible="False">

                                <Border Background="#1E1E1E"
                                        CornerRadius="15"
                                        Padding="15"
                                        Width="220">

                                    <StackPanel>

                                        <TextBlock Text="관리자 문의"
                                                    FontSize="15"
                                                    FontWeight="Bold"
                                                    Foreground="White"
                                                    Margin="0,0,0,10"/>

                                        <Separator Margin="0,0,0,10"/>

                                        <TextBlock Text="📞 010-1234-5678"
                                                   Foreground="White"
                                                   Margin="0,0,0,5"/>

                                        <TextBlock Text="🕒 09:00 ~ 18:00"
                                                   Foreground="White"
                                                   Margin="0,0,0,5"/>

                                        <TextBlock Text="🏢 1층 안내데스크"
                                                   Foreground="White"/>

                                    </StackPanel>

                                </Border>
                            </ContextMenu>
                        </ui:Button.ContextMenu>
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Person16" FontSize="60" Foreground="White" Margin="0,0,0,20"/>
                            <TextBlock Text="관리자 문의" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>
                </ui:Card>
            </Grid>
        </Grid>
        <!-- Dashboard -->
    </Grid>
</Page>
