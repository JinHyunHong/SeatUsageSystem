<Page
  x:Class="SeatUsageSystem.Views.Pages.LoginPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:helpers="clr-namespace:SeatUsageSystem.Helpers"
  xmlns:local="clr-namespace:SeatUsageSystem.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="LoginPage"
  d:DataContext="{d:DesignInstance local:LoginPage,
                                     IsDesignTimeCreatable=False}"
  d:DesignHeight="450"
  d:DesignWidth="800"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  mc:Ignorable="d"
>
    <Grid>

        <StackPanel Orientation="Vertical" x:Name="pnlLogin" Width="300" Visibility="{Binding ViewModel.IsLoggedIn, Converter={StaticResource InverseBoolToVisibilityConverter}}" HorizontalAlignment="Left">
            <ui:TextBlock Text="로그인" FontSize="20" FontWeight="Bold" Margin="0,0,0,30"/>

            <ui:TextBlock Margin="0,0,0,10">
                <Run Text="이름 "/>
                <Run Text="*" Foreground="OrangeRed"/>
            </ui:TextBlock>
            <ui:TextBox x:Name="tbxName" Text="{Binding ViewModel.InputName, Mode=TwoWay}" Margin="0,0,0,20"/>
            <ui:TextBlock Margin="0,0,0,10">
                <Run Text="연락처 "/>
                <Run Text="*" Foreground="OrangeRed"/>
            </ui:TextBlock>
            <ui:TextBox x:Name="tbxPhoneNumer" Text="{Binding ViewModel.InputPhoneNumber, Mode=TwoWay}" PlaceholderText="010-1234-5678" MaxLength="13" Margin="0,0,0,10"/>

            <ui:Button x:Name="btnLogin" Content="로그인" Command ="{Binding ViewModel.LoginCommand, Mode=OneWay}" HorizontalAlignment="Stretch" Height="40" Background="#4CAF50" Foreground="White" FontWeight="Bold" Margin="0,0,0,30"/>
        </StackPanel>

        <StackPanel Orientation="Vertical" x:Name="pnlLogout" Width="300" Visibility="{Binding ViewModel.IsLoggedIn, Converter={StaticResource BoolToVisibilityConverter}}" HorizontalAlignment="Left">
            <ui:TextBlock x:Name="tbkName" Text="{Binding ViewModel.CurrentUserName, StringFormat={}{0}님, Mode=OneWay}" FontSize="20" FontWeight="Bold" Margin="0,0,0,30"/>

            <ui:Button x:Name="btnLogout" Content="로그아웃" Command ="{Binding ViewModel.LogoutCommand, Mode=OneWay}" HorizontalAlignment="Stretch" Height="40" Background="#E53935" Foreground="White" FontWeight="Bold"/>
        </StackPanel>

        
    </Grid>
</Page>
